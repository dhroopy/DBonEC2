[Unit]
Description=MySQL full backup to S3
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/mysql-server
EnvironmentFile=/opt/mysql-server/.env
Environment=TZ=Asia/Kolkata
ExecStart=/opt/mysql-server/scripts/backup-full.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=append:/opt/mysql-server/logs/backup-full.log
StandardError=append:/opt/mysql-server/logs/backup-full.log
